{
  "manifest_version": 3,
  "name": "LookMeNot - Langfuse Trace Reader",
  "short_name": "LookMeNot",
  "version": "0.1.0",
  "description": "Read Langfuse traces, tool calls, and agent actions as a conversation in a left-side pane.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://langfuse.com/*", "https://*.langfuse.com/*"],
  "action": {
    "default_title": "Open LookMeNot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://langfuse.com/*", "https://*.langfuse.com/*"],
      "js": ["assets/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js", "icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
